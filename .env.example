# DocuMind environment variables template
# Copy this file to .env.local (local dev) and fill in the values.
# For a FREE cloud deploy, see the "FREE DEPLOY" section at the bottom and DEPLOYMENT.md.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-min-32-chars-development-key!!
APP_VERSION=1.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://documind:documind_dev@localhost:5432/documind

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run ingestion inline instead of via a worker (handy for single-process deploys).
CELERY_TASK_ALWAYS_EAGER=false

# ─── JWT / Auth cookie ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars-dev!!
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Cross-site (different domains for web + API) needs samesite=none AND secure=true.
COOKIE_SAMESITE=strict
COOKIE_SECURE=true

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=documind-dev

# ─── AI provider (OpenAI-compatible) ───────────────────────────────────────────
# Works with OpenAI, Google Gemini, Groq, OpenRouter — anything OpenAI-compatible.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# OpenAI honours the `dimensions` param; set false for providers that don't (Gemini).
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_BATCH_SIZE=100

# ─── RAG ──────────────────────────────────────────────────────────────────────
RERANKER_BACKEND=passthrough
# RERANKER_BACKEND=cohere
# COHERE_API_KEY=your-cohere-api-key

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ════════════════════════════════════════════════════════════════════════════
# FREE DEPLOY (Google Gemini + Supabase + Upstash + Render + Vercel)
# Override the relevant vars above with these on your hosting provider:
#
#   APP_ENV=production
#   DEBUG=false
#   # AI — Google AI Studio key (free): https://aistudio.google.com/apikey
#   OPENAI_API_KEY=<your-gemini-api-key>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_CHAT_MODEL=gemini-2.0-flash
#   OPENAI_EMBEDDING_MODEL=text-embedding-004
#   EMBEDDING_DIMENSIONS=768
#   EMBEDDING_SEND_DIMENSIONS=false
#   EMBEDDING_BATCH_SIZE=1
#   # Postgres + pgvector — Neon or Supabase (free). Use the asyncpg driver:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME
#   DB_SSL=true
#   # Redis — Upstash (free, TLS). Use the SAME url for all three:
#   REDIS_URL=rediss://default:PASSWORD@HOST:6379
#   CELERY_BROKER_URL=rediss://default:PASSWORD@HOST:6379
#   CELERY_RESULT_BACKEND=rediss://default:PASSWORD@HOST:6379
#   CELERY_TASK_ALWAYS_EAGER=true
#   # Cross-site auth (Vercel web ↔ Render API):
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
#   CORS_ALLOW_CREDENTIALS=true
#   CORS_ORIGINS=["https://your-app.vercel.app"]
#
# Frontend (Vercel) — set at build time:
#   NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# ════════════════════════════════════════════════════════════════════════════
